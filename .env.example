# Lumen reads this file in both `npm run dev` and `npm start`.
# Copy it to .env and fill in your key. Never commit .env.

# Groq API key: https://console.groq.com/keys
# Powers Lumo's tips, insights, the grown-up summary and home ideas,
# and the natural voice. Without it, Lumen uses templates and the device voice.
GROQ_API_KEY=

# Optional: text model. By default Lumen picks the smartest model your key can
# use (openai/gpt-oss-120b, then qwen/qwen3.8-27b, then openai/gpt-oss-20b).
# If this one isn't available to your key, it falls back and says so at startup.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: natural voice. The voice model needs its terms accepted once:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Voices: hannah (default), autumn, diana, austin, daniel, troy.
# GROQ_TTS_VOICE=hannah
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Optional: port for `npm start` (default 4173).
# PORT=4173
