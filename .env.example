# Lumen reads this file in both `npm run dev` and `npm start`.
# Copy it to .env and fill in your key. Never commit .env.

# Groq API key: https://console.groq.com/keys
# Powers Lumo's tips, insights, the grown-up summary and home ideas,
# and the natural voice. Without it, Lumen uses templates and the device voice.
GROQ_API_KEY=

# Optional: text model. By default Lumen picks the smartest model your key can
# use (openai/gpt-oss-120b, then qwen/qwen3.8-27b, then openai/gpt-oss-20b).
# If this one isn't available to your key, it falls back and says so at startup.
# GROQ_MODEL=openai/gpt-oss-120b

# Natural voice, option 1 (preferred): Fish Audio, free model "s2.1-pro-free".
# Key: https://fish.audio (API keys). Pick a voice in the Fish Audio library and copy its id.
# FISH_API_KEY=
# FISH_VOICE_ID=
# FISH_MODEL=s2.1-pro-free
# Offer more voices in Settings (id:Label, comma separated):
# FISH_VOICES=

# Natural voice, option 2: Google Cloud Text-to-Speech, Chirp 3 HD voices.
# Enable the "Cloud Text-to-Speech API" in a Google Cloud project, then either
# create an API key restricted to that API:
# GOOGLE_TTS_API_KEY=
# or point to a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Voice (default en-US-Chirp3-HD-Leda). Others: Aoede, Kore, Achernar, Sulafat, Puck, Charon.
# GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Leda

# Natural voice, option 3: Groq Orpheus (used when Fish and Google aren't set up).
# The voice model needs its terms accepted once:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Voices: hannah (default), autumn, diana, austin, daniel, troy.
# GROQ_TTS_VOICE=hannah
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Optional: port for `npm start` (default 4173).
# PORT=4173

# Always-on fallback: a voice made on this server, so Lumo can talk in every browser.
# eSpeak is used automatically if installed. For a natural offline voice, install Piper and set:
# PIPER_MODEL=/absolute/path/to/en_US-amy-medium.onnx
# PIPER_BIN=piper

# Accounts database. Locally a file is used (data/lumen.db, or LUMEN_DB=...).
# For free hosting without a disk, use Turso (https://app.turso.tech, free):
# TURSO_DATABASE_URL=libsql://lumen-<your-name>.turso.io
# TURSO_AUTH_TOKEN=
