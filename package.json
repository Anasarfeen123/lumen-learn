{
  "name": "lumen",
  "private": true,
  "version": "1.0.0",
  "description": "Lumen: an adaptive literacy game for dyslexic learners, guided by Lumo the firefly.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check:words": "vitest run src/engine/wordbank.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "voices": "node scripts/build-voices.mjs",
    "pictures": "node scripts/fetch-pictures.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}
